{
  "expo": {
    "name": "Ride Tracker",
    "slug": "disney-ride-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "disneyridetracker",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.aaron.disneyridetracker",
      "appleTeamId": "33EW9K7GFS",
      "version": "1.0",
      "buildNumber": "1",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "CFBundleDisplayName": "Ride Tracker",
        "LSApplicationCategoryType": "public.app-category.entertainment"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "Allow Disney Ride Tracker to attach selected photos and videos to ride logs."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/castle-splash.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "./plugins/with-ios-project-settings"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
